# ========================================================
# Bahavar Music Platform - Environment Configuration Example
# ========================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=bahavar-super-secret-key-change-in-production-!@#$%^&*()
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,bahavarmusic.com,www.bahavarmusic.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bahavarmusic.com

# --- Database Settings (PostgreSQL or SQLite fallback) ---
USE_SQLITE=False
POSTGRES_DB=bahavar_db
POSTGRES_USER=bahavar_user
POSTGRES_PASSWORD=bahavar_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Object Storage (ArvanCloud / MinIO / S3 Compatible) ---
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
AWS_STORAGE_BUCKET_NAME=bahavar-media
AWS_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
AWS_S3_REGION_NAME=ir-thr-at1
AWS_S3_CUSTOM_DOMAIN=media.bahavarmusic.com

# --- Payment Gateway (Zarinpal / Behpardakht) ---
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
PAYMENT_CALLBACK_URL=http://localhost:3000/shop/callback

# --- SMS / OTP Provider ---
SMS_OTP_PROVIDER=mock
KAVENEGAR_API_KEY=your-kavenegar-api-key-optional

# --- Frontend Nuxt Configuration ---
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
